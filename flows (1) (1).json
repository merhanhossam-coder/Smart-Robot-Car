    {
        "id": "9b70fd98508a0c54",
        "type": "function",
        "z": "39ce3e4f1b5f68e4",
        "name": "Check Login",
        "func": "let username = global.get(\"login_username\") || \"\";\nlet password = global.get(\"login_password\") || \"\";\n\nlet correctUser = \"admin\";\nlet correctPass = \"1234\";\n\n// غير اسم التاب حسب اسم تاب التحكم عندك\nlet controlTabName = \"Smart Robot\";\n\nif (username === correctUser && password === correctPass) {\n    global.set(\"loggedIn\", true);\n\n    let statusMsg = {\n        payload: \"Login successful ✅\"\n    };\n\n    let goToControlTab = {\n    payload: {\n        page: controlTabName\n    }\n};\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: \"Logged in\"\n    });\n\n    return [statusMsg, goToControlTab];\n} else {\n    global.set(\"loggedIn\", false);\n\n    let statusMsg = {\n        payload: \"Wrong username or password ❌\"\n    };\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"Login failed\"\n    });\n\n    return [statusMsg, null];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
