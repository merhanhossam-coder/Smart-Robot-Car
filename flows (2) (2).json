    {
        "id": "59cce5b8cfb3bf61",
        "type": "function",
        "z": "robot_tab",
        "name": "function 1",
        "func": "let loggedIn = global.get(\"loggedIn\") || false;\n\nif (!loggedIn) {\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: \"Login required\"\n    });\n    return null;\n}\n\nlet threshold = Number(msg.payload);\n\nflow.set(\"threshold\", threshold);\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"Threshold = \" + threshold + \"°C\"\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 180,
        "wires": [
            []
        ]
    },
